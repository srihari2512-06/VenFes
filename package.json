{
  "name": "venfes-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Vendor E-Commerce Platform with Analytics (MERN)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "server:install": "npm install --prefix server",
    "client:install": "npm install --prefix client",
    "server:test": "npm test --prefix server",
    "server:dev": "npm run dev --prefix server",
    "client:build": "npm run build --prefix client",
    "client:dev": "npm run dev --prefix client",
    "test": "npm test --prefix server",
    "build": "npm run build --prefix client",
    "seed": "node server/src/seed.js"
  }
}
